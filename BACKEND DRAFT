from dataclasses import dataclass
from typing import Dict, Union, List, Any


# PAYMENT TRANSACTION MODULE

PAYMENT_STRUCTURE = {
    "Bills": ["government", "electricity", "internet", "water"],
    "Bank": ["loans", "transfer"],
    "Credits": ["shopping", "games", "load"]
}

@dataclass
class payment_details:
    category: str
    subcategory: str
    biller: str
    account_reference: str
    amount: float

def validate_payment(details: payment_details) -> bool:
    cat = details.category.capitalize() if details.category else ""
    subcat = details.subcategory.lower() if details.subcategory else ""

    # Check if category exists
    if cat not in PAYMENT_STRUCTURE:
        return False

    if subcat not in PAYMENT_STRUCTURE[cat]:
        return False    

    # Check required text fields and positive amount
    if not details.biller or not details.account_reference or details.amount <= 0:
        return False
        
    return True

#shared global sequence counter for ALL transactions
global_sequence = 1

def payment_reference_number(sequence_value: int) -> str:
    return f"PAY-{sequence_value:09d}"

# Confirmation and processing for payment transactions
def confirm_payment(details: payment_details) -> Dict[str, Union[str, float, bool, None]]:
    global global_sequence
    
    if not validate_payment(details):
        return {
            "Status": "Failed",
            "Message": "Invalid Payment Category or Transaction Details",
            "Data": None
        }
    
    ref_num = payment_reference_number(global_sequence)
    global_sequence += 1
    
    payment_info = {
        "Status": "Success",
        "Reference Number": ref_num,
        "Category": details.category.capitalize(),
        "Subcategory": details.subcategory.title(),
        "Biller/Provider": details.biller,
        "Account/Reference": details.account_reference,
        "Amount": details.amount,
    }
    
    return payment_info

# SEND TRANSACTION MODULE

# Storing account details using data class instead of the usual class declaration
@dataclass
class account_details:
    account_number: str
    account_name: str
    amount: float

# Enter account details 
def validate_account(account_number: str, account_name: str) -> bool:
    # Validation via number or name
    if not account_number or not account_name:
        return False
    return True

# Amount // checks if the amount is not zero or less than 0
def validate_amount(amount: float) -> bool:
    return amount > 0

# Generates reference number
def reference_number(sequence_value: int) -> str:
    return f"{sequence_value:012d}"

# Confirmation // check transaction details via dictionary using the combination of string, float and boolean in the save file
def confirm_transaction(details: account_details) -> Dict[str, Union[str, float, bool, None]]:
    global global_sequence
    
    # Confirmation step
    is_valid_account = validate_account(details.account_number, details.account_name)
    is_valid_amount = validate_amount(details.amount)
    
    #Returns the status, the failed transaction message and no data
    if not (is_valid_account and is_valid_amount):
        return {
            "Status" : "Failed",
            "Message": "Invalid Transaction",
            "Data" : None
        }
    
    ref_num = reference_number(global_sequence)
    global_sequence += 1

    # Displays transaction info 
    transaction_info = {
        "Status" : "Success",
        "Reference Number" : ref_num,
        "Account Name" : details.account_name,
        "Account Number" : details.account_number,
        "Amount" : details.amount,
    }
    
    return transaction_info


